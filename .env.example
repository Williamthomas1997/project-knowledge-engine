# Copy to .env and fill in. Never commit .env.

# Development database (Neo4j Desktop or docker/docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Integration tests. Default (auto): Testcontainers if Docker runs, otherwise the NEO4J_TEST_* server.
# PKE_TEST_NEO4J_MODE=auto|testcontainers|external|none
PKE_TEST_NEO4J_MODE=auto
# A dedicated database: the tests delete all of its data. 'neo4j' and 'system' are refused.
NEO4J_TEST_URI=bolt://localhost:7687
NEO4J_TEST_USERNAME=neo4j
NEO4J_TEST_PASSWORD=change-me-please
NEO4J_TEST_DATABASE=pketest

# Only needed with the 'openai' Spring profile
OPENAI_API_KEY=sk-your-key-here
