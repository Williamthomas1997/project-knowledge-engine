        "name": "CAN_RETURN_ERROR",
        "description": "The API can end with this error code: its handler, or a method the handler calls (up to 4 hops), raises it.",
        "category": "technical",
        "sourceTypes": [
          "ApiOperation"
        ],
        "targetTypes": [
          "ErrorCode"
        ],
        "rationale": "APIs are HANDLED_BY methods that CALL methods which THROW_ERROR codes; people ask which errors an API can return, which today needs a variable-length traversal.",
        "population": {
          "method": "query",
          "query": "MATCH (api:ApiOperation)-[:HANDLED_BY]->(:JavaMethod)-[:CALLS*0..4]->(:JavaMethod)-[:THROWS_ERROR]->(e:ErrorCode) RETURN DISTINCT api.pke_id AS subjectId, e.pke_id AS objectId, e.code AS evidence"
        }
      },
      {
        "name": "SHARES_BUSINESS_RULE_WITH",
        "description": "The two APIs enforce the same business rule.",
        "category": "business",
        "sourceTypes": [
          "ApiOperation"
        ],
        "targetTypes": [
          "ApiOperation"
        ],
        "rationale": "APIs whose handlers reach the same method may enforce the same rule.",
        "population": {
          "method": "query",
          "query": "MATCH (a:ApiOperation)-[:HANDLED_BY]->(:JavaMethod)-[:CALLS*1..4]->(m:JavaMethod)<-[:CALLS*1..4]-(:JavaMethod)<-[:HANDLED_BY]-(b:ApiOperation) WHERE a.pke_id < b.pke_id RETURN DISTINCT a.pke_id AS subjectId, b.pke_id AS objectId"
        }
